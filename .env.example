# OPENROUTER_API_KEY: OpenRouter API key for LLM generation (works on Vercel and production).
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Optional preferred model slug (defaults to 'openrouter/auto' if left empty).
OPENROUTER_MODEL="openrouter/auto"

# GEMINI_API_KEY: Fallback Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
